NODE_ENV=development
PORT=3000

DB_SERVER=localhost
DB_PORT=1433
DB_DATABASE=nome_do_banco
DB_USER=usuario_do_banco
DB_PASSWORD=senha_do_banco
DB_ENCRYPT=true
DB_TRUST_SERVER_CERT=true

PNCP_BASE_URL=https://treina.pncp.gov.br/api/pncp
PNCP_TIMEOUT=30000
PNCP_RETRY_ATTEMPTS=3

PNCP_AUTH_URL=https://treina.pncp.gov.br/api/pncp/v1/autenticacao
PNCP_CLIENT_ID=seu-client-id
PNCP_CLIENT_SECRET=seu-client-secret
